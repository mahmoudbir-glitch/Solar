# Copy to .env in this folder and fill in. Never commit .env.

# --- Local HTTP listener -------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Secret this gateway requires on POST /v1/inverter/test.
# Generate it in Solar: إعدادات الإنفرتر > توليد رمز الربط. It is shown once.
GATEWAY_TOKEN=change-me

# --- Pushing readings to Solar ----------------------------------------
SOLAR_API_URL=https://your-solar.vercel.app

# MUST be byte-for-byte the same value as TELEMETRY_INGEST_TOKEN in the
# Vercel project. If they differ, every push is rejected with 401 and no
# reading ever reaches the dashboard.
SOLAR_TELEMETRY_TOKEN=change-me

POLL_INTERVAL_SECONDS=10

# --- Inverter register map ----------------------------------------------
# Which register map to read with. It MUST match the inverter model: addresses
# and scaling differ between models, and a wrong map reports plausible but
# false readings. The gateway refuses to read rather than guess.
#
# Bundled profiles:
#   ivem6048-ii   Felicity IVEM6048-II
#
# NEXT Power Victor Max-8.2KW is NOT bundled — no verified register map is
# published for it. Add one to PROFILES in gateway.py from the Next Power
# manual, then name it here. See README.md.
INVERTER_PROFILE=ivem6048-ii

# Offset added to every register address, for maps documented 1-based.
INVERTER_REGISTER_OFFSET=0
