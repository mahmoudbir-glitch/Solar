# Solar sign-in (server only, never use NEXT_PUBLIC_ here).
# Set these in Vercel > Project Settings > Environment Variables.
SOLAR_AUTH_USERNAME="admin"
SOLAR_AUTH_PASSWORD="change-this-password"
# Signs the session cookie and encrypts the saved inverter secrets. 32+ random characters.
SOLAR_AUTH_SECRET="replace-with-a-long-random-secret"

# Optional separate owner account. When set, only this account can change
# settings, inverter connections and devices, or open /admin/monitor.
# SOLAR_OWNER_USER="owner"
# SOLAR_OWNER_PASSWORD="replace-with-owner-password"

# PostgreSQL (required): readings, settings, forecasts and the sign-in log live here.
# Keep it configured in Vercel Production + Preview.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# Names some Vercel/Prisma integrations create; used when DATABASE_URL is absent.
# PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# SmartESS / DessMonitor account of the Wi-Fi Plug Pro (server only).
# Adopted automatically by the inverter connection until an account is saved
# from the settings page. SMARTESS_PN is the datalogger's PN.
SMARTESS_USERNAME="Plugpro"
SMARTESS_PASSWORD="change-this-password"
SMARTESS_PN="Q0045395318912"

# Lets a scheduler call /api/telemetry/sync (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="replace-with-a-different-random-secret"
# Lets a local gateway post readings to /api/telemetry.
TELEMETRY_INGEST_TOKEN="replace-with-a-long-random-secret"

# Optional: a separate key for the saved inverter secrets (defaults to SOLAR_AUTH_SECRET).
# INVERTER_CONFIG_SECRET="replace-with-a-long-random-32-byte-secret"
