# Solar authentication
# Set these values in Vercel Project Settings > Environment Variables.
SOLAR_AUTH_USERNAME=admin
SOLAR_AUTH_PASSWORD=change-this-password
SOLAR_AUTH_SECRET=replace-with-a-long-random-secret

# SmartESS / DessMonitor cloud connection (server-side only)
SMARTESS_USERNAME=Plugpro
SMARTESS_PASSWORD=change-this-password
SMARTESS_COMPANY_KEY=replace-with-platform-company-key
SMARTESS_PN=Q0031256230580

# Local inverter gateway (optional fallback / advanced local telemetry)
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=change-this-token
